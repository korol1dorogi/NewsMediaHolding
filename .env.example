# Works as is: `cp .env.example .env && docker compose up -d --build --wait`.
# Every value below is a placeholder for local runs. Never put real secrets here.
# An empty or missing variable falls back to the default in backend/config/settings.py.

# Port on the host where the app (frontend + /api) is served
WEB_PORT=8080

# Django
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=local-dev-placeholder-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app-local-placeholder
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# LLM: "mock" is deterministic and needs no key.
# For a real model set an OpenAI-compatible endpoint (open-weight model).
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
