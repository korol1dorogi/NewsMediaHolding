# Works as is: `cp .env.example .env && docker compose up -d --build --wait`.
# Every value below is a placeholder for local runs. Never put real secrets here.
# An empty or missing variable falls back to the default in backend/config/settings.py.

# Port on the host where the app (frontend + /api) is served
WEB_PORT=8080

# Django
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=local-dev-placeholder-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_LOG_LEVEL=INFO

# Local demo placeholders only. Seed explicitly: python manage.py seed_demo.
DEMO_USER_PASSWORD=demo-user-placeholder
DEMO_LAWYER_PASSWORD=demo-lawyer-placeholder
DEMO_MODERATOR_PASSWORD=demo-moderator-placeholder
DEMO_EDITOR_PASSWORD=demo-editor-placeholder
# Shared Redis fixed-window limits, independently per remote IP and account.
AUTH_LOGIN_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=60
# Only for bundled Caddy ingress: it overwrites X-NMH-Client-IP; backend is not public.
AUTH_TRUST_PROXY_HEADER=true

# PostgreSQL
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app-local-placeholder
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# LLM: "mock" is deterministic and needs no key.
# For a real model set an OpenAI-compatible endpoint (open-weight model).
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Payments: demo only, no real money moves. Amounts in kopecks, shares in basis points (1% = 100).
PAYMENTS_PROVIDER=demo
PAYMENTS_CLAIM_PRICE_KOPECKS=149000
PAYMENTS_REVIEWER_SHARE_BP=7000
PAYMENTS_PLATFORM_FEE_BP=1000
