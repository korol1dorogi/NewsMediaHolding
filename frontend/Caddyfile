{
	admin off
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# One origin: API and frontend share the host, so no CORS is needed.
	handle_path /static/* {
		root * /srv/admin-static
		file_server
	}

	@admin path /admin /admin/*
	handle @admin {
		reverse_proxy backend:8000
	}

	handle /api/* {
		reverse_proxy backend:8000 {
			header_up X-NMH-Client-IP {remote_host}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
