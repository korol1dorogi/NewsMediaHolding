{
  "info": {
    "name": "NewsMediaHolding API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:8080" }],
  "item": [
    {
      "name": "health",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/health" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "ready",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/ready" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('all checks pass', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('ready');",
              "  pm.expect(body.checks.database).to.eql(true);",
              "  pm.expect(body.checks.redis).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "unknown route is 404",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/does-not-exist" },
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('status 404', () => pm.response.to.have.status(404));"] }
        }
      ]
    }
  ]
}
