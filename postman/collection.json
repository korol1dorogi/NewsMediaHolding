      "name": "login as lawyer",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRFToken",
            "value": "{{csrf}}"
          }
        ],
        "body": {
          "mode": "raw",
